# Copy to .env and add your key for LLM-narrated insights. Without it,
# falls back to templated text.
#
# Free key: https://openrouter.ai/keys. If the model below stops working,
# check https://openrouter.ai/models?max_price=0 for a current free one.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Production deployment ---
# Set on the public deployment; leave unset for local dev.

# Comma-separated frontend origin(s) allowed to call this API. No wildcard, no default here --
# a public deploy left on the localhost:3000 default effectively rejects real browser traffic.
ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# "production" hides /docs, /redoc, /openapi.json and adds HSTS. Leave unset (or anything
# else) for local dev, where the interactive docs are genuinely useful.
ENVIRONMENT=production

# Only set to true if this API sits behind a reverse proxy/CDN that sets X-Forwarded-For.
# Leaving this unset/false when there IS a trusted proxy makes rate limiting see only the
# proxy's IP for every visitor; leaving it true when there ISN'T one lets any client spoof
# their rate-limit identity by just sending that header themselves.
TRUST_PROXY_HEADERS=false

# How many /analyze requests (Monte Carlo + optimization) may run at once, process-wide.
MAX_CONCURRENT_ANALYSES=2
