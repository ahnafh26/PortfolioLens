# Copy to .env and add your key for LLM-narrated insights. Without it,
# falls back to templated text.
#
# Free key: https://openrouter.ai/keys. If the model below stops working,
# check https://openrouter.ai/models?max_price=0 for a current free one.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
